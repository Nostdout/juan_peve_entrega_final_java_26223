<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<!-- Configuración y gestión de tu proyecto cuando trabajas con Maven en Java y Spring Boot. -->
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.techlab</groupId>
	<artifactId>coffee-api</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Coffee API MySQL</name>
	<description>API REST CRUD con Spring Boot</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
	</properties>
	<!-- Dependencias principales -->
	<dependencies>
		<!-- Permite manejar bases de datos relacionales mediante JPA (Java Persistence API) e Hibernate.
		Permite mapear las clases de Java (entidades) directamente a tablas de la base de datos y 
		provee herramientas (JpaRepository) para hacer consultas sin necesidad de 
		escribir código SQL manual. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Prepara la aplicación para construir APIs REST y aplicaciones web. 
		Incluye el servidor web embebido (por defecto Tomcat), gestiona controladores (@RestController), 
		procesa peticiones HTTP (GET, POST, etc.) y convierte automáticamente los objetos de Java 
		a formato JSON (Jackson). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Es el driver oficial de MySQL para Java (JDBC Driver). 
		Le proporciona a Spring Boot el traductor necesario para comunicarse físicamente 
		con el servidor de base de datos MySQL. -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<!-- Solo necesita este driver cuando la aplicación está ejecutándose -->
			<scope>runtime</scope>
		</dependency>
		<!-- Dependencias de Pruebas-->
		<!-- Provee herramientas y anotaciones (como @DataJpaTest) diseñadas específicamente para 
		probar la capa de persistencia, repositorios y consultas a la base de datos 
		de forma aislada. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Ofrece utilidades (como @WebMvcTest) para probar los controladores web y 
		endpoints HTTP simulando peticiones sin necesidad de levantar 
		todo el servidor web completo. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Herramienta estándar en Spring Boot uqe permite asegurar que los datos que envían 
		los usuarios cumplan con ciertas reglas antes de guardarlos en la base de datos o 
		procesarlos. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
	</dependencies>

	<!-- bloque de Plugins -->
	<!-- Plugin oficial de Maven para Spring Boot. 
	Su trabajo principal es empaquetar toda la aplicación junto con el servidor web embebido (Tomcat) 
	en un único archivo ejecutable JAR o WAR, permitiendo ejecutarla fácilmente desde la terminal 
	con un comando o ejecutando el archivo compilado con java. -->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>

